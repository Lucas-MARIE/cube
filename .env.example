# ============================================================
# Cube.com - Environment Configuration
# Copy this file to .env and update values for your environment.
# NEVER commit the .env file to version control.
# ============================================================

# === Global ===
COMPOSE_PROJECT_NAME=cube

# === User Service ===
USER_SERVICE_PORT=8001
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cube_users
POSTGRES_USER=cube
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://cube:changeme@postgres:5432/cube_users
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# === Learning Service ===
LEARNING_SERVICE_PORT=8002
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=cube_learning

# === Session Service ===
SESSION_SERVICE_PORT=8003
REDIS_HOST=redis
REDIS_PORT=6379

# === Frontend ===
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:8080/api
